# Test image: dev + prod deps and Playwright Chromium baked in so the suite
# runs without installing anything at run time. Debian slim (not Alpine) is
# required because Playwright browsers are unsupported on musl.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /yamtrack

# Python deps first (requirements-dev.txt pulls in requirements.txt) so the
# dependency layer caches independently of source changes.
COPY requirements.txt requirements-dev.txt ./
RUN pip install -r requirements-dev.txt

# Chromium + its OS libraries for the Playwright integration tests.
RUN playwright install --with-deps chromium

# Django app. test_settings uses fakeredis + eager Celery, so no live
# Redis/worker is needed. Commands run from src/.
COPY src ./src
WORKDIR /yamtrack/src

# Default: full suite. Override to run other checks, e.g.
#   docker run --rm IMAGE ruff check .
#   docker run --rm IMAGE python manage.py check_migration_hygiene --strict
CMD ["coverage", "run", "manage.py", "test", "app", "users", "integrations", "lists", "events", "--parallel"]
